---
import { home, profile } from '../lib/content';

const links = [
  { label: 'Journey', href: '/journey' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="foot">
  <nav aria-label="Footer">
    <ul class="foot__links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <ul class="foot__links">
    <li><a href={profile.githubUrl} target="_blank" rel="me noopener">GitHub</a></li>
    <li><a href={profile.linkedinUrl} target="_blank" rel="me noopener">LinkedIn</a></li>
    <li><a href={`mailto:${profile.email}`}>Email</a></li>
  </ul>
  <p class="foot__note">{home.footerNote}</p>
</footer>
