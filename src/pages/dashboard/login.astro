---
import CourtLines from '../../components/dashboard/CourtLines.astro';
import Private from '../../layouts/Private.astro';
import { ownerSession } from '../../lib/server/http';

export const prerender = false;

if (await ownerSession(Astro)) return Astro.redirect('/dashboard', 303);
---

<Private title="Sign in">
  <div class="auth">
    <header class="dash-top">
      <a class="nav__logo" href="/" aria-label="Back to the public site">PJ</a>
      <button class="toggle" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2.5a9.5 9.5 0 0 1 0 19z" fill="currentColor"></path></svg>
      </button>
    </header>
    <main id="main" tabindex="-1" class="auth__stage">
      <div class="auth__card">
        <CourtLines />
        <h1 class="auth__title">Welcome back.</h1>
        <p class="auth__text">Sign in with the passkey on this device. There's no password to type or to steal.</p>
        <button class="btn btn--primary" type="button" data-sign-in>Sign in with passkey</button>
        <p class="dash-alert" role="alert" data-alert hidden></p>
        <p class="auth__fine">First time, or a new device? Run <code>npm run dashboard:setup</code> in your terminal for a one-time link.</p>
      </div>
    </main>
  </div>
</Private>

<script>
  import '../../scripts/sign-in';
</script>
