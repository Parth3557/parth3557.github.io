# Nothing here is needed to run locally. Local runs use .data/portfolio.db and http://localhost:4321.
# Set these in Vercel's environment variables for production. Never commit real values.

# The site's exact public address. Login and CSRF checks trust this, never the request's Host header.
SITE_ORIGIN=https://parth3557.vercel.app

# Dashboard database (Turso free plan).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Keystatic editing through GitHub. docs/deploy.md explains how to create the GitHub App.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# A random string of at least 32 characters.
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
