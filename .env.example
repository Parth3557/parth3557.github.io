# Nothing here is needed to run locally. Local runs use .data/portfolio.db and http://localhost:4321.
# Set these in Vercel's environment variables for production. Never commit real values.

# The dashboard's exact address. Login and CSRF checks trust this, never the request's Host header.
SITE_ORIGIN=https://parth3557.vercel.app

# The public pages' exact address. It may send visits to the dashboard's server, and nothing else.
PUBLIC_SITE_ORIGIN=https://parth3557.github.io

# Dashboard database (Turso free plan).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Keystatic editing through GitHub. docs/deploy.md explains how to create the GitHub App.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# A random string of at least 32 characters.
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Set as a variable on the GitHub repository, not in Vercel, because it's used when building the public pages.
# Leaving it empty means the public pages count nothing and send nothing.
# PUBLIC_COLLECT_URL=https://parth3557.vercel.app/api/collect
