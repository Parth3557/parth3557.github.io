{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": "24.x" },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "node scripts/fetch-fonts.mjs && astro build",
    "start": "node scripts/start-local.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:http": "vitest run --config vitest.http.config.ts",
    "dashboard:setup": "node scripts/dashboard-setup.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.18",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@libsql/client": "0.18.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwindcss": "4.3.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.0.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.9.2",
    "vitest": "5.1.0"
  }
}
